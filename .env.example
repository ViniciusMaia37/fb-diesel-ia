# Copie este arquivo para ".env" e preencha os valores. O arquivo .env NUNCA vai para o GitHub.

# Chave da API da Anthropic (Claude). Crie em https://platform.claude.com/settings/keys
# Sem a chave o sistema funciona, mas o chat responde só com os trechos da base de conhecimento.
ANTHROPIC_API_KEY=

# Modelo de IA (padrão: claude-opus-5-5) e nível de esforço de raciocínio (low | medium | high)
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_EFFORT=medium

# Endereço do servidor. Use HOST=0.0.0.0 para acessar de outros computadores da rede.
PORT=3000
HOST=127.0.0.1

# Primeiro administrador (usado só quando o banco está vazio).
# Se ADMIN_PASSWORD ficar vazio, uma senha provisória é gerada e mostrada no terminal.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Duração da sessão de login, em horas
SESSION_HOURS=12

# Use 1 quando o sistema estiver atrás de HTTPS (cookie seguro)
COOKIE_SECURE=0

# Caminho do banco SQLite (padrão: data/fb-diesel.db)
# DB_PATH=data/fb-diesel.db
